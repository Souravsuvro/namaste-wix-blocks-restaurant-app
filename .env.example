# ============================================================
# Namaste Gien — Wix Blocks App Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env — it is gitignored
# ============================================================

# Wix App Configuration
WIX_APP_ID=your_wix_app_id_here
WIX_APP_SECRET=your_wix_app_secret_here
WIX_INSTANCE_ID=your_wix_instance_id_here

# Restaurant Public Config
RESTAURANT_NAME=Namaste Gien
RESTAURANT_PHONE=+33751517109
RESTAURANT_EMAIL=contact@namastegien.fr
RESTAURANT_ADDRESS=2 Pl. du Maréchal Foch, 45500 Gien, France

# Node
NODE_ENV=development
PORT=3000
