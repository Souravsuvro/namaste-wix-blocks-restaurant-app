{
  "name": "namaste-wix-blocks-restaurant-app",
  "version": "1.0.0",
  "description": "Wix Blocks restaurant management app — menu display, online ordering, table reservations, and delivery management for Wix sites.",
  "main": "backend/menu-api.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "validate": "node scripts/validate-schemas.js"
  },
  "keywords": [
    "wix",
    "wix-blocks",
    "restaurant",
    "menu",
    "ordering",
    "reservations",
    "delivery",
    "wix-app-market"
  ],
  "author": "Namaste GIEN",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "babel-jest": "^30.3.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^wix-data$": "<rootDir>/tests/__mocks__/wix-data.js",
      "^wix-crm$": "<rootDir>/tests/__mocks__/wix-crm.js",
      "^backend/(.*)$": "<rootDir>/backend/$1"
    },
    "transform": {
      "^.+\\.js$": [
        "babel-jest",
        {
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ]
        }
      ]
    },
    "transformIgnorePatterns": []
  },
  "wix": {
    "appDefinitionId": "namaste-restaurant-app",
    "blocksVersion": "2.0"
  }
}
